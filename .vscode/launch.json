{
  // Configuraciones de depuracion para VS Code (F5).
  // "justMyCode": false permite entrar tambien en customtkinter y en la
  // biblioteca estandar, util cuando el problema esta en el widget y no en
  // nuestro codigo.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App (modo depuracion)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--debug"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "App (normal)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Pruebas: todas",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Pruebas: archivo abierto",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "args": ["-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Empaquetar (publish.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/build/publish.py",
      "args": ["--skip-build"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
